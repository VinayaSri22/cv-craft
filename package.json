{
  "name": "cv-craft",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n web,api -c blue,magenta \"npm run dev -w @cv-craft/web\" \"npm run dev -w @cv-craft/server\"",
    "build": "npm run build -w @cv-craft/web && npm run build -w @cv-craft/server",
    "start": "npm run start -w @cv-craft/server",
    "test:pdf": "PDF_SMOKE=1 vitest run apps/server",
    "user:reset-password": "node apps/server/src/cli/resetPassword.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^9.2.5",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "vitest": "^5.0.5"
  }
}
